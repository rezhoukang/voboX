<Window x:Class="voboX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:voboX.Controls"
        mc:Ignorable="d"
        Title="voboX"
        Icon="/Assets/voboX.ico"
        Width="420" Height="780"
        MinWidth="400" MinHeight="560"
        WindowStyle="None"
        Background="{StaticResource WindowBg}"
        FontFamily="Microsoft YaHei UI"
        Foreground="{StaticResource TextPrimary}"
        UseLayoutRounding="True"
        AllowDrop="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <!-- 自定义标题栏：CaptionHeight 区域可拖动/双击最大化，按钮命中优先 -->
    <WindowChrome.WindowChrome>
        <!-- CaptionHeight=0：关闭系统拖拽区（否则会拦截标题栏按钮的点击），改为手动拖拽 -->
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <!-- 主窗口布局：0=顶部菜单栏，1=内容区（搜索/分组/全选/列表），2=底部波形播放裁剪区 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ 顶部菜单栏（手动拖拽区：空白拖窗口，按钮正常点击） ============ -->
        <Border x:Name="TitleBar" Grid.Row="0" Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1"
                PreviewMouseLeftButtonDown="TitleBar_PreviewMouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左上：项目名 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="voboX" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}"/>
                </StackPanel>

                <!-- 录制 + 导入 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Button x:Name="RecordButton" Style="{StaticResource ToolButtonStyle}" Tag="&#xE720;"
                            Content="录制" Click="Record_Click"/>
                    <Button Style="{StaticResource ToolButtonStyle}" Tag="&#xE896;" Content="导入"
                            Margin="2,0,0,0" Click="Import_Click"/>
                </StackPanel>

                <!-- 右上：设置 / 钉子 / 最小化 / 关闭 -->
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button x:Name="SettingsButton" Style="{StaticResource WinCtrlButtonStyle}" Tag="&#xE713;" Click="Settings_Click"/>
                    <Button x:Name="PinButton" Style="{StaticResource WinCtrlButtonStyle}" Tag="&#xE77A;"
                            Click="Pin_Click" MouseEnter="PinButton_MouseEnter" MouseLeave="PinButton_MouseLeave"/>
                    <Button Style="{StaticResource WinCtrlButtonStyle}" Tag="&#xE921;" Click="Minimize_Click"/>
                    <Button Style="{StaticResource CloseButtonStyle}" Tag="&#xE8BB;" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 主内容区 ============ -->
        <Grid Grid.Row="1" Margin="14,12,14,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 搜索框（右侧：搜索范围标签 + 下拉三角） -->
            <Border Grid.Row="0" Background="{StaticResource PanelBg}" CornerRadius="8"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                               Foreground="{StaticResource TextMuted}" FontSize="14" VerticalAlignment="Center"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource SearchBoxStyle}"
                             Margin="8,0,4,0" TextChanged="SearchBox_TextChanged"/>
                    <!-- 选中全局/voboX搜索后显示的范围标签：灰色圆角 + X 清除 -->
                    <Border x:Name="ScopeChip" Grid.Column="2" Visibility="Collapsed"
                            Background="#FF3A3A42" CornerRadius="11" Margin="0,3,6,3" Padding="10,1,4,1"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ScopeChipText" Text="全局搜索" FontSize="11.5"
                                       VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}"/>
                            <Button x:Name="ScopeChipClear" Click="ScopeChipClear_Click"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Width="18" Height="18" Padding="0" Margin="8,0,0,0"
                                    VerticalAlignment="Center" ToolTip="恢复默认（当前视图）">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5">
                                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                                   Foreground="{StaticResource TextSecondary}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#FF4A4A54"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Button x:Name="SearchScopeButton" Grid.Column="3" Click="SearchScopeButton_Click"
                            Style="{StaticResource ToolButtonStyle}" Tag="&#xE70D;" Content=""
                            Padding="4,4" ToolTip="搜索范围：当前视图"/>
                </Grid>
            </Border>

            <!-- 内容层：主内容全宽 + 浮动导航栏（从左侧凸出，不占用主内容）+ 展开/收起按钮 -->
            <Grid Grid.Row="1" Margin="0,10,0,0">

                <!-- 主内容（全宽，不被导航栏挤压） -->
                <Grid x:Name="MainContent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 全选行：上下分隔线；左=全选+已选数量，右=当前文件夹文件数 -->
                    <Grid Grid.Row="0" Margin="2,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1"/>
                        </Grid.RowDefinitions>
                        <Rectangle Grid.Row="0" Height="1" Fill="{StaticResource SeparatorBrush}"/>
                        <DockPanel Grid.Row="1" Margin="0,8,0,8" LastChildFill="False">
                            <CheckBox x:Name="SelectAllCheck" Style="{StaticResource ListCheckBoxStyle}" IsThreeState="True"
                                      ToolTip="全选" DockPanel.Dock="Left" VerticalAlignment="Center"
                                      Click="SelectAllCheck_Click"/>
                            <TextBlock x:Name="SelectedCountText" Text="已选择 0 个文件" FontSize="12"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center" Margin="6,0,0,0" DockPanel.Dock="Left"/>
                            <TextBlock x:Name="FileCountText" Text="全部文件" FontSize="12"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center" DockPanel.Dock="Right"/>
                        </DockPanel>
                        <Rectangle Grid.Row="2" Height="1" Fill="{StaticResource SeparatorBrush}"/>
                    </Grid>

                    <!-- 文件列表 -->
                    <Grid Grid.Row="1" Margin="0,6,0,0">
                        <ListBox x:Name="FileList"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True"
                                 ItemContainerStyle="{StaticResource FileItemStyle}"
                                 SelectionMode="Extended"
                                 SelectionChanged="FileList_SelectionChanged"
                                 PreviewKeyDown="FileList_PreviewKeyDown"
                                 MouseDoubleClick="FileList_MouseDoubleClick"
                                 PreviewMouseMove="FileList_PreviewMouseMove"
                                 PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown"
                                 ContextMenuOpening="FileList_ContextMenuOpening">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 1. 选择复选框（最左） -->
                                        <CheckBox Grid.Column="0" Style="{StaticResource ListCheckBoxStyle}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Click="ItemCheckBox_Click" VerticalAlignment="Center"
                                                  Margin="0,0,4,0"/>

                                        <!-- 2. 名称（整体向下微调 1px，与复选框光学校齐） -->
                                        <StackPanel Grid.Column="1" Margin="6,0,8,0" VerticalAlignment="Center"
                                                    RenderTransformOrigin="0.5,0.5">
                                            <StackPanel.RenderTransform>
                                                <TranslateTransform Y="1"/>
                                            </StackPanel.RenderTransform>
                                            <TextBlock FontSize="13" Foreground="{StaticResource TextPrimary}"
                                                       TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding FileName, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- 时长 -->
                                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="11"
                                                   Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"
                                                   FontFamily="Consolas"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 空状态提示 -->
                        <TextBlock Text="此文件夹暂无音频&#10;点击「导入」或直接拖入 WAV"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMuted}" FontSize="13"
                                   TextAlignment="Center" IsHitTestVisible="False" LineHeight="22">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Items.Count, ElementName=FileList}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>

                <!-- 主内容全宽；展开/收起按钮由独立悬浮窗承担（NavButtonWindow） -->
            </Grid>
        </Grid>

        <!-- ============ 底部波形区（选中文件后显示） ============ -->
        <Border x:Name="BottomPlayer" Grid.Row="2" Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,1,0,0"
                Padding="14,10,14,12" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 控制条 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="PlayButton" Grid.Column="0" Style="{StaticResource RoundIconButtonStyle}"
                            Tag="&#xE768;" ToolTip="播放 / 暂停" Click="PlayButton_Click"/>
                    <TextBlock x:Name="CurrentFileName" Grid.Column="1" FontSize="12.5"
                               Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"
                               Margin="10,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TimeText" Grid.Column="2" FontFamily="Consolas" FontSize="11"
                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                    <Button x:Name="CropButton" Grid.Column="3" Style="{StaticResource AccentButtonStyle}"
                            Content="裁剪保存" Margin="8,0,0,0" Click="CropButton_Click"/>
                </Grid>

                <!-- 波形（含裁剪选区交互） -->
                <controls:WaveformView x:Name="Waveform" Grid.Row="1" Height="90" Margin="0,8,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
