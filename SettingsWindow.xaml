<Window x:Class="voboX.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" Background="{StaticResource WindowBg}"
        FontFamily="Microsoft YaHei UI" Foreground="{StaticResource TextPrimary}">
    <Window.Resources>
        <!-- 设置窗口统一黑白灰高对比度：文字只用白/亮灰，任何状态不出现黑字 -->
        <SolidColorBrush x:Key="SettingsLabelBrush" Color="#FFC9C9D1"/>
        <SolidColorBrush x:Key="SettingsCaretBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="SettingsSelectionBrush" Color="#335A5A64"/>
        <SolidColorBrush x:Key="SettingsHoverBorder" Color="#FF8A8A94"/>

        <!-- 下拉框选项：覆盖全局蓝色选中态，改为灰色高亮 -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF3D3D45"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF5A5A64"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 下拉框：白字、灰色悬停边框、灰色下拉面板 -->
        <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="toggle" Focusable="False" ClickMode="Press"
                                          Foreground="{TemplateBinding Foreground}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="{StaticResource PanelBg}"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                            <Grid>
                                                <ContentPresenter Margin="10,0,30,0" VerticalAlignment="Center"
                                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                                <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           Margin="0,0,8,0" Foreground="{StaticResource TextSecondary}"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource SettingsHoverBorder}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                                <Border Background="#FF16161A" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6"
                                        MinWidth="{TemplateBinding ActualWidth}" Margin="0,2,0,0">
                                    <ScrollViewer MaxHeight="220">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 路径输入框：白字、白色光标、灰色选中背景 -->
        <Style x:Key="SettingsPathBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="{StaticResource SettingsCaretBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource SettingsSelectionBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- 保存按钮：灰底白字（去掉蓝色） -->
        <Style x:Key="SettingsSaveButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF3D3D45"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF5A5A64"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF6B6B75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource WindowBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="{StaticResource PanelBg}">
                <Grid>
                    <TextBlock Text="设置" FontSize="13" FontWeight="SemiBold" Margin="14,0,0,0"
                               VerticalAlignment="Center"/>
                    <Button Style="{StaticResource WinCtrlButtonStyle}" Tag="&#xE8BB;"
                            HorizontalAlignment="Right" Click="Close_Click"/>
                </Grid>
            </Border>

            <!-- 内容 -->
            <StackPanel Grid.Row="1" Margin="16,14,16,16">

                <TextBlock Text="录制来源（录制屏幕声音请选「立体声混音」）"
                           FontSize="11" Foreground="{StaticResource SettingsLabelBrush}"/>
                <ComboBox x:Name="DeviceCombo" Style="{StaticResource SettingsComboBoxStyle}"
                          Margin="0,5,0,14"/>

                <TextBlock Text="文件排序规则" FontSize="11" Foreground="{StaticResource SettingsLabelBrush}"/>
                <ComboBox x:Name="SortCombo" Style="{StaticResource SettingsComboBoxStyle}"
                          Margin="0,5,0,14">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" Foreground="White"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- 打开 Box 文件夹（左对齐）+ 清空 tempBox（右对齐） -->
                <Grid Margin="0,5,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource ToolButtonStyle}" Content="打开 Box 文件夹"
                            Padding="14,6" FontSize="12"
                            HorizontalAlignment="Left" Click="OpenBoxFolder_Click"/>
                    <Button Grid.Column="1" Style="{StaticResource ToolButtonStyle}" Content="清空 tempBox"
                            Padding="14,6" FontSize="12" Click="ClearTempbox_Click"/>
                </Grid>

                <TextBlock Text="拷贝真实文件到 voboX"
                           FontSize="11" Foreground="{StaticResource SettingsLabelBrush}" Margin="0,16,0,0"/>
                <TextBlock Text="把 log 索引的外部文件实际拷贝进 voboX 对应文件夹（拷入后 log 自动移除）"
                           FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="SaveBoxPathText" FontSize="11" Foreground="{StaticResource TextSecondary}"
                           Margin="0,4,0,0" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Style="{StaticResource SettingsSaveButtonStyle}" Content="拷贝" Click="CopyToVobox_Click"/>
                    <Button Style="{StaticResource ToolButtonStyle}" Content="打开文件夹" Padding="14,6" FontSize="12"
                            Margin="6,0,0,0" Click="SaveBoxOpen_Click"/>
                </StackPanel>

                <!-- 底部：左 = 开机自启动；右 = 取消 / 保存 -->
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" x:Name="AutoStartCheck" Content="开机自启动"
                              Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource ToolButtonStyle}" Content="取消" Padding="14,6" FontSize="12" Click="Cancel_Click"/>
                        <Button Style="{StaticResource SettingsSaveButtonStyle}" Content="保存" Margin="8,0,0,0" Click="Save_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
