<Window x:Class="voboX.Windows.NavWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导航" Width="200" WindowStyle="None" ShowInTaskbar="False"
        ShowActivated="False" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI" Foreground="{StaticResource TextPrimary}">
    <Window.Resources>
        <!-- 所有层级（根目录/子文件夹）统一：悬浮=一层背景提示，选中=白色框 -->
        <Style x:Key="NavTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsSelected" Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#26FFFFFF"/>
                </MultiTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="BorderBrush" Value="White"/>
                    <Setter Property="Background" Value="#1AFFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="10" Padding="6" Margin="1">
        <TreeView x:Name="FolderTree" Background="Transparent" BorderThickness="0"
                  Foreground="{StaticResource TextPrimary}"
                  SelectedItemChanged="FolderTree_SelectedItemChanged"
                  ContextMenuOpening="FolderTree_ContextMenuOpening">
            <TreeView.Resources>
                <!-- 覆盖系统默认蓝色选中高亮，改用灰色样式（不点蓝） -->
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
            </TreeView.Resources>
            <TreeView.ItemContainerStyle>
                <StaticResource ResourceKey="NavTreeItemStyle"/>
            </TreeView.ItemContainerStyle>
        </TreeView>
    </Border>
</Window>
