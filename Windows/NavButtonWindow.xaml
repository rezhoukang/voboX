<Window x:Class="voboX.Windows.NavButtonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导航" Width="22" Height="48" WindowStyle="None" ShowInTaskbar="False"
        ShowActivated="False" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize">
    <Button x:Name="Btn" Click="Btn_Click">
        <!-- 四角钝角的黑色实心矩形按钮，白色箭头 -->
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border x:Name="bd" Background="#FF000000" CornerRadius="8">
                    <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="11"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="bd" Property="Background" Value="#FF333333"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
    </Button>
</Window>
