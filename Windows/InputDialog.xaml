<Window x:Class="voboX.Windows.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" Background="{StaticResource WindowBg}"
        FontFamily="Microsoft YaHei UI" Foreground="{StaticResource TextPrimary}">
    <Border Background="{StaticResource WindowBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <StackPanel Margin="16,16">
            <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <TextBox x:Name="InputBox" Style="{StaticResource PathBoxStyle}" KeyDown="InputBox_KeyDown"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Style="{StaticResource ToolButtonStyle}" Content="取消" Click="Cancel_Click"/>
                <Button Style="{StaticResource AccentButtonStyle}" Content="确定" Margin="8,0,0,0" Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
